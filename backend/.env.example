# Primary AI provider: Google Gemini (backend only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI secondary provider; leave the key/model blank to disable fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# AI service controls (in-memory per backend process)
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=20
AI_RATE_LIMIT_RETRIES=2
AI_MAX_INLINE_RETRY_SECONDS=8
AI_RESPONSE_CACHE_TTL_SECONDS=300
AI_METRICS_TOKEN=

# Optional provider pricing (USD per 1 million tokens) for estimated usage metrics.
AI_GEMINI_INPUT_USD_PER_1M=
AI_GEMINI_OUTPUT_USD_PER_1M=
AI_SECONDARY_INPUT_USD_PER_1M=
AI_SECONDARY_OUTPUT_USD_PER_1M=

# Server configuration
PORT=8000
HOST=127.0.0.1

# Authentication database (SQLite; keep this file private and backed up)
MEDIGUIDE_DB_PATH=backend/mediguide.sqlite3

# Frontend origin (must match the browser origin used for OAuth)
FRONTEND_URL=http://localhost:5173

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/

# Google Places API key for real hospital searches (backend only)
GOOGLE_MAPS_API_KEY=

# Sign in with Apple (register APPLE_REDIRECT_URI as the Service ID return URL)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Password-reset email delivery (SMTP with STARTTLS by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Required to create doctor accounts; issue only to physicians verified by an administrator
DOCTOR_SIGNUP_CODE=
