# Google Gemini API key (optional; demo mode is used if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Server configuration
PORT=8000
HOST=127.0.0.1

# Authentication database (SQLite; keep this file private and backed up)
MEDIGUIDE_DB_PATH=backend/mediguide.sqlite3

# Frontend origin (must match the browser origin used for OAuth)
FRONTEND_URL=http://localhost:5173

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/

# Sign in with Apple (register APPLE_REDIRECT_URI as the Service ID return URL)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Password-reset email delivery (SMTP with STARTTLS by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Required to create doctor accounts; issue only to physicians verified by an administrator
DOCTOR_SIGNUP_CODE=
